{
  "name": "zephinax",
  "version": "0.0.3",
  "description": "CLI wrapper for adding components from the Zephinax registry using shadcn.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start:dev": "node dist/index.js",
    "publish:release": "pnpm build && pnpm publish --access public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["zephinax", "cli", "shadcn", "components", "registry"],
  "author": "Zephinax <zephinax@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://zephinax.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zephinax/personal-website.git",
    "directory": "packages/ncdai"
  },
  "funding": "https://github.com/sponsors/Zephinax",
  "bugs": {
    "url": "https://github.com/Zephinax/personal-website/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "packageManager": "pnpm@10.10.0"
}
